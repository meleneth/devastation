#!/usr/bin/env bash
set -euo pipefail

domain="${DEVASTATION_DOMAIN:-deva.station}"
endpoint="${S3_ENDPOINT:-https://s3.${domain}}"
bucket="${S3_BUCKET:-devastation-dev}"
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-devastation}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-devastation-secret}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"

key="smoke/$(date +%s).txt"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

printf 'devastation seaweedfs smoke\n' >"$tmp"

aws --endpoint-url "$endpoint" s3api head-bucket --bucket "$bucket" >/dev/null
aws --endpoint-url "$endpoint" s3 cp "$tmp" "s3://${bucket}/${key}" >/dev/null
downloaded="$(aws --endpoint-url "$endpoint" s3 cp "s3://${bucket}/${key}" -)"
test "$downloaded" = "devastation seaweedfs smoke"
aws --endpoint-url "$endpoint" s3 rm "s3://${bucket}/${key}" >/dev/null

printf '[ok] SeaweedFS S3 upload/download succeeded at %s bucket %s\n' "$endpoint" "$bucket"
