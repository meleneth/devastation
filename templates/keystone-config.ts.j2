import { config, list } from '@keystone-6/core';
import { allowAll } from '@keystone-6/core/access';
import { text, password, timestamp, relationship } from '@keystone-6/core/fields';
import { createAuth } from '@keystone-6/auth';
import { statelessSessions } from '@keystone-6/core/session';

const sessionSecret = process.env.KEYSTONE_SESSION_SECRET || '{{ keystone_session_secret }}';
const adminEmail = process.env.KEYSTONE_ADMIN_EMAIL || '{{ keystone_admin_email }}';
const adminPassword = process.env.KEYSTONE_ADMIN_PASSWORD || '{{ keystone_admin_password }}';
const cookieDomain = process.env.KEYSTONE_COOKIE_DOMAIN || '{{ devastation_domain }}';
const allowedOriginPattern = /^https:\/\/([a-z0-9-]+\.)*{{ devastation_domain | regex_escape }}(?::\d+)?$/;

const baseSession = statelessSessions({
  secret: sessionSecret,
  maxAge: 60 * 60 * 24 * 30,
  domain: cookieDomain,
  path: '/',
  secure: true,
  sameSite: 'lax',
});

const session = {
  ...baseSession,
  end: async (args: Parameters<typeof baseSession.end>[0]) => {
    await baseSession.end(args);
    if (!args.context.res) return;

    const hostOnlyExpiredCookie = `keystonejs-session=; Max-Age=0; Path=/; Expires=${new Date().toUTCString()}; HttpOnly; Secure; SameSite=Lax`;
    const existing = args.context.res.getHeader('Set-Cookie');
    const cookies = Array.isArray(existing) ? existing : existing ? [existing.toString()] : [];
    args.context.res.setHeader('Set-Cookie', [...cookies, hostOnlyExpiredCookie]);
  },
};

const { withAuth } = createAuth({
  listKey: 'User',
  identityField: 'email',
  secretField: 'password',
  sessionData: 'id name email',
  initFirstItem: {
    fields: ['name', 'email', 'password'],
    itemData: {
      name: 'Devastation Admin',
      email: adminEmail,
      password: adminPassword,
    },
  },
});

export default withAuth(
  config({
    db: {
      provider: 'postgresql',
      url: process.env.DATABASE_URL || 'postgres://{{ postgres_default_user }}:{{ postgres_default_password }}@keystone-db:5432/keystone',
      onConnect: async (context) => {
        const existing = await context.db.User.findOne({ where: { email: adminEmail } });
        if (!existing) {
          await context.db.User.createOne({
            data: {
              name: 'Devastation Admin',
              email: adminEmail,
              password: adminPassword,
            },
          });
        }
      },
    },
    server: {
      port: 3000,
      cors: {
        origin: allowedOriginPattern,
        credentials: true,
      },
    },
    session,
    lists: {
      User: list({
        access: allowAll,
        fields: {
          name: text({ validation: { isRequired: true } }),
          email: text({ validation: { isRequired: true }, isIndexed: 'unique' }),
          password: password({ validation: { isRequired: true } }),
          avatarUrl: text({
            ui: { description: 'Local profile image URL for generated app experiments.' },
          }),
          createdAt: timestamp({ defaultValue: { kind: 'now' } }),
          notes: relationship({ ref: 'Note.author', many: true }),
        },
      }),
      Note: list({
        access: allowAll,
        fields: {
          title: text({ validation: { isRequired: true } }),
          body: text({ ui: { displayMode: 'textarea' } }),
          author: relationship({ ref: 'User.notes' }),
          createdAt: timestamp({ defaultValue: { kind: 'now' } }),
        },
      }),
    },
  })
);
