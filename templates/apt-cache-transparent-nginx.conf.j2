server {
    listen {{ apt_cache_transparent_port }};
    server_name _;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_pass http://apt-cache:3142;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
